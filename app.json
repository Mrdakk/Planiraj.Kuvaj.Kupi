{
  "expo": {
    "name": "Planiraj.Kuvaj.Kupi",
    "slug": "planiraj-kuvaj-kupi",
    "version": "1.0.0",
    "scheme": "planirajkuvajkupi",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4EFE6"
    },
    "androidNavigationBar": {
      "backgroundColor": "#F4EFE6",
      "barStyle": "dark-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pkk.planirajkuvajkupi"
    },
    "android": {
      "package": "com.pkk.planirajkuvajkupi",
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "backgroundColor": "#C45C26",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-image",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikacija koristi kameru da skenira QR kod porodice.",
          "barcodeScannerEnabled": true,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a"
            ]
          }
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e74dcf6-0a90-4dd6-b8f8-f7ba571ddc96"
      }
    }
  }
}
